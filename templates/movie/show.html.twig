{% extends 'base.html.twig' %}

{% block title %}Fiche film{% endblock %}

{% block body %}

    <h1>Fiche du film</h1>

    <div class="card" style="max-width: 320px">
        <div class="card-body">
            <h4 class="card-title">{{ movie.title }}</h4>
            <p class="card-text">{{ movie.synopsis }}</p>
            <p class="card-text">Année : {{ movie.year }}</p>
            <p class="card-text">Catégorie : {{ movie.category }}</p>
            <p class="card-text">Note : {{ movie.rating }} {% if movie.rating >= 4.5 %} Coup de coeur {% endif %}</p>
        </div>
    </div>

{% endblock %}