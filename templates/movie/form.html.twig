{% extends "base.html.twig" %}

{% block title %}Ajouter un film{% endblock %}

{% block body %}
<a href="{{ path('app_movie_list') }}" class="btn btn-primary mb-3">Retour à la liste</a>
    <h1>Ajouter un film</h1>

    {{ form_start(form) }}
        {{ form_row(form.Titre) }}
        {{ form_row(form.synopsis) }}
        {{ form_row(form.date_sortie) }}
        {{ form_row(form.category) }}
        {{ form_row(form.note) }}
        {{ form_row(form.duree)}}
        <button type="submit" class="btn">Ajouter</button>
    {{ form_end(form) }}

{% endblock %}